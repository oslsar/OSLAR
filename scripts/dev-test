#!/usr/bin/env bash
set -u

cd "$(dirname "$0")/.."

echo
echo "========================================"
echo " OSLAR DEVELOPMENT TEST"
echo "========================================"
echo

FAIL=0

echo "[1/5] Development containers"
for container in oslar-dev-web oslar-dev-postgres oslar-dev-playwright; do
    if docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null | grep -q true; then
        echo "  PASS  $container"
    else
        echo "  FAIL  $container"
        FAIL=1
    fi
done

echo
echo "[2/5] OSLAR DEV HTTP"
STATUS=$(curl -s -o /dev/null -w "%{http_code}" \
    --max-time 10 http://127.0.0.1:3002/ || true)

if [ "$STATUS" = "200" ]; then
    echo "  PASS  HTTP $STATUS"
else
    echo "  FAIL  HTTP $STATUS"
    FAIL=1
fi

echo
echo "[3/5] Git diff check"
if git diff --check; then
    echo "  PASS  git diff --check"
else
    echo "  FAIL  git diff --check"
    FAIL=1
fi

echo
echo "[4/5] Compiler lookup-plan tests"
if docker exec \
    -e OSLAR_PREVIEW_BASE_URL=http://127.0.0.1:3000 \
    oslar-dev-web \
    node --experimental-strip-types \
    --test ai-tests/compiler-lookup-plan.test.mjs; then
    echo "  PASS  Compiler lookup-plan tests"
else
    echo "  FAIL  Compiler lookup-plan tests"
    FAIL=1
fi

echo
echo "[5/5] Browser regression tests"
if docker exec oslar-dev-playwright \
    npx playwright test \
    tests/smoke.spec.js \
    tests/entities.spec.js \
    tests/entities-readonly.spec.js; then
    echo "  PASS  Playwright"
else
    echo "  FAIL  Playwright"
    FAIL=1
fi

echo
echo "========================================"

if [ "$FAIL" -eq 0 ]; then
    echo " RESULT: PASS"
    echo "========================================"
    exit 0
else
    echo " RESULT: FAIL"
    echo "========================================"
    exit 1
fi
